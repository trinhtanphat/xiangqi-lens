{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/core/*.js",
    "src/engine/*.js",
    "src/vision/*.js",
    "src/overlay/*.js",
    "src/app/analysis-controller.js",
    "src/api/http.js",
    "src/web/app.js"
  ],
  "exclude": [
    "**/*.test.js"
  ]
}
